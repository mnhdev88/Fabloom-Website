Options -Indexes

# PHP error handling (disable in production)
# php_flag display_errors Off
# php_value error_reporting 0

RewriteEngine On

# ── Canonical scheme and host ─────────────────────────────────
# Until now http://, https://, www and non-www all answered 200, so every page
# existed at four addresses and the checkout collected addresses and phone
# numbers over plain HTTP. This runs FIRST, before any of the clean-URL rules
# below, so a request is normalised in a single redirect rather than chained
# through two.
#
# The %{HTTPS} test is paired with X-Forwarded-Proto: LiteSpeed sets %{HTTPS}
# directly, but behind a proxy or CDN only the header is trustworthy, and
# redirecting on the wrong signal is an infinite loop.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.thefabloom.com%{REQUEST_URI} [R=301,L,QSA]

# Non-www to www, on HTTPS. Matches the host used in canonical tags, the
# sitemap and llms.txt, so all four agree.
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} !^$
RewriteRule ^ https://www.thefabloom.com%{REQUEST_URI} [R=301,L,QSA]

# ── Extensionless URLs ────────────────────────────────────────
# /about  ->  about.php   (and /locations/silk-supplier-salem, etc.)
#
# api/ is excluded from the .php -> clean-URL redirect below: those are
# POST endpoints for the cart and enquiry forms, and a 301 turns a POST
# into a GET, silently dropping the submitted data.

# 1. Old .html URLs -> clean URL
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)\.html$ /$1 [R=301,L,QSA]

# 2. /index.php (or /some/dir/index.php) -> the directory itself
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.*)index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,QSA]

# 2b. /product?slug=x (and /product.php?slug=x) -> /product/x
# Products used to live on a query string, which robots.txt blocked outright
# via "Disallow: /*?*". This runs before rule 3 so the .php form collapses in
# a single hop rather than two. THE_REQUEST is the original request line, so
# the internal rewrite in 3c below never re-enters this rule.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+product(\.php)?\?slug=([A-Za-z0-9._-]+)[\s&] [NC]
RewriteRule ^ /product/%2? [R=301,L]

# 3. Any other visible .php URL -> clean URL, GET only, never under api/
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(?!api/)([^\s?]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,QSA]

# 3b. /blog/<slug> -> blog-post.php?slug=<slug>
RewriteRule ^blog/([A-Za-z0-9-]+)/?$ /blog-post.php?slug=$1 [L,QSA]

# 3c. /product/<slug> -> product.php?slug=<slug>
RewriteRule ^product/([A-Za-z0-9._-]+)/?$ /product.php?slug=$1 [L,QSA]

# 4. Serve the clean URL from the real .php file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ /$1.php [L,QSA]

# HTTPS is forced at the top of this file, before the rewrite rules.

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS. Deliberately short (1 day) and without preload: once a browser has
  # cached this it will refuse plain HTTP for the whole max-age, so a long
  # value is unforgiving of a certificate lapse. Raise to 31536000 and add
  # preload only after the redirect above has run clean for a few weeks.
  Header always set Strict-Transport-Security "max-age=86400" env=HTTPS
</IfModule>

# ── Compression ───────────────────────────────────────────────
# CSS and JS were already served brotli-compressed, but HTML was not: the
# homepage shipped 92KB of uncompressed markup on every request. HTML is the
# most compressible thing on the site — it is mostly repeated tag names and
# whitespace — so this is the single cheapest performance win available.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml

  # Never compress what is already compressed.
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|zip|gz|mp4|woff2?)$ no-gzip dont-vary
</IfModule>

# Protect config directory.
# "Order/Deny" is Apache 2.2 syntax; on Apache 2.4 without mod_access_compat
# it throws "Invalid command 'Order'" and returns HTTP 500 for the ENTIRE
# site. Use the 2.4 directive where available and fall back to 2.2.
<Files "database.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Never serve the pre-conversion static copies
RedirectMatch 404 ^/_backup-html/

# Prevent direct access to includes
<IfModule mod_rewrite.c>
  RewriteRule ^includes/ - [F,L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon  "access plus 1 month"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  # LiteSpeed serves .js as text/javascript, so the application/javascript rule
  # above never matched and every script was re-downloaded on every visit.
  ExpiresByType text/javascript        "access plus 1 week"
  ExpiresByType video/mp4  "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
